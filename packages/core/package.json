{
  "name": "frimaicons",
  "version": "0.1.0",
  "description": "Company logos as SVG data: Paystack to GCash, one package.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "build": "pnpm generate && tsup",
    "typecheck": "pnpm generate && tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
