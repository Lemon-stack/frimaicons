{
  "name": "@frimaicons/core",
  "version": "0.3.0",
  "description": "Company logos as SVG data: Paystack to GCash, one package.",
  "license": "MIT",
  "author": "Lemon Confidence",
  "homepage": "https://github.com/Lemon-stack/frimaicons#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lemon-stack/frimaicons.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/Lemon-stack/frimaicons/issues"
  },
  "keywords": [
    "logos",
    "brand",
    "icons",
    "svg",
    "fintech",
    "nigeria",
    "africa",
    "startups"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "build": "pnpm generate && tsup",
    "typecheck": "pnpm generate && tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
