{
  "name": "@frimaicons/react",
  "version": "0.3.0",
  "description": "Company logos as React components.",
  "license": "MIT",
  "author": "Lemon Confidence",
  "homepage": "https://github.com/Lemon-stack/frimaicons#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lemon-stack/frimaicons.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/Lemon-stack/frimaicons/issues"
  },
  "keywords": [
    "logos",
    "brand",
    "icons",
    "svg",
    "react",
    "react-components",
    "nigeria",
    "africa"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "build": "pnpm generate && tsup",
    "typecheck": "pnpm generate && tsc --noEmit",
    "test": "pnpm generate && vitest run",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@frimaicons/core": "workspace:*"
  }
}
